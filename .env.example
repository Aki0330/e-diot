#
# 澶嶅埗涓?.env.local 鍚庡～鍏ョ湡瀹炲€硷紱.env.local 宸茶 .gitignore 蹇界暐銆?# 鍙栧€间紭鍏堢骇锛氳繘绋嬬幆澧?> .env.local > .env
# 鏃ч」鐩?.env.local 涓殑閿悕鍏ㄩ儴淇濈暀锛屾柊澧為敭瑙佸悇鍒嗚妭娉ㄩ噴銆?# 鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺愨晲鈺?
# 鈹€鈹€ 搴旂敤 鈹€鈹€
APP_NAME=CyberBudget
APP_VERSION=0.1.0
APP_DEBUG=false
APP_ENV=development # development | production | test
LOG_LEVEL=info # fatal | error | warn | info | debug | trace | silent

# 鈹€鈹€ API 鏈嶅姟锛坅pps/api锛?鈹€鈹€
# 娉細docker-compose 閲岀殑 Attu 宸叉敼鍒板涓?3100锛?000 鐣欑粰 API
API_HOST=127.0.0.1
API_PORT=8000
# 鍏佽鐨勮法鍩熸潵婧愶紝閫楀彿鍒嗛殧锛? 琛ㄧず鍏ㄩ儴锛堢瓑浠锋棫鐗?allow_origin_regex=".*"锛?CORS_ORIGINS=*
# 鍓嶇鏋勫缓浜х墿鐩綍锛堢浉瀵逛粨搴撴牴鐩綍锛夛紝鐢?apps/api 鍚屾簮鎵樼
STATIC_DIR=apps/web/dist

# 鈹€鈹€ 鏁版嵁搴擄紙PostgreSQL 16锛?鈹€鈹€
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyber_budget_db
DB_USER=postgres
DB_PASSWORD=postgrespassword
# 瀹屾暣杩炴帴涓诧紝璁剧疆鍚庤鐩栦笂闈㈢殑鍒嗗瓧娈甸厤缃?# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/cyber_budget_db
DB_POOL_MAX=10
DB_SSL=false

# 鈹€鈹€ JWT锛堝繀濉細涓虹┖鏃舵湇鍔″惎鍔ㄥ嵆澶辫触锛屼笉绛夐娆＄櫥褰曪級 鈹€鈹€
# 鐢熸垚锛歯ode -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 鈹€鈹€ LLM锛圤penAI 鍏煎锛岄粯璁?DeepSeek锛?鈹€鈹€
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 鈹€鈹€ Tavily 鎼滅储锛圡CP 鐨?web_search 宸ュ叿锛?鈹€鈹€
TAVILY_API_KEY=

# 鈹€鈹€ Milvus锛圡CP 鐭ヨ瘑搴撴贩鍚堟绱級 鈹€鈹€
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=financial_knowledge_base
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3

# 鈹€鈹€ 鎺ㄧ悊 sidecar锛坰ervices/inference锛岃鏂规 6.3锛?鈹€鈹€
INFERENCE_BASE_URL=http://127.0.0.1:8100
INFERENCE_TIMEOUT_MS=60000
# 浠?sidecar 鑷韩璇诲彇锛沵odels/ 涓嶅鍒讹紝鐢ㄨ矾寰勫紩鐢ㄦ棫鐩綍
# EMBEDDING_MODEL_PATH=D:\PROJECT\mcp_tool_sample\models\embedding\bge-m3
# RERANKER_MODEL_PATH=D:\PROJECT\mcp_tool_sample\models\reranker\bge-reranker-v2-m3

# 鈹€鈹€ MCP Server锛坅pps/mcp锛?鈹€鈹€
MCP_HOST=127.0.0.1
MCP_PORT=8001

# 鈹€鈹€ Redis锛堟棫鐗堜笟鍔′唬鐮佹湭浣跨敤锛屾湰鏈熶笉鎺ュ叆锛?鈹€鈹€
