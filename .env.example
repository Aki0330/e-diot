# ═══════════════════════════════════════════════════════════
# CyberBudget（TypeScript 版）环境变量样例
#
# 复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 忽略。
# 取值优先级：进程环境 > .env.local > .env
# 旧项目 .env.local 中的键名全部保留，新增键见各分节注释。
# ═══════════════════════════════════════════════════════════

# ── 应用 ──
APP_NAME=CyberBudget
APP_VERSION=0.1.0
APP_DEBUG=false
APP_ENV=development # development | production | test
LOG_LEVEL=info # fatal | error | warn | info | debug | trace | silent

# ── API 服务（apps/api） ──
# 注：docker-compose 里的 Attu 已改到宿主 3100，8000 留给 API
API_HOST=127.0.0.1
API_PORT=8000
# 允许的跨域来源，逗号分隔；* 表示全部（等价旧版 allow_origin_regex=".*"）
CORS_ORIGINS=*
# 前端构建产物目录（相对仓库根目录），由 apps/api 同源托管
STATIC_DIR=apps/web/dist

# ── 数据库（PostgreSQL 16） ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyber_budget_db
DB_USER=postgres
DB_PASSWORD=postgrespassword
# 完整连接串，设置后覆盖上面的分字段配置
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/cyber_budget_db
DB_POOL_MAX=10
DB_SSL=false

# ── JWT（必填：为空时服务启动即失败，不等首次登录） ──
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM（OpenAI 兼容，默认 DeepSeek） ──
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ── Tavily 搜索（MCP 的 web_search 工具） ──
TAVILY_API_KEY=

# ── Milvus（MCP 知识库混合检索） ──
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=financial_knowledge_base
HYBRID_DENSE_WEIGHT=0.7
HYBRID_SPARSE_WEIGHT=0.3
# 本地没有 Milvus / 推理 sidecar 时设为 false，chat 跳过知识检索
KNOWLEDGE_ENABLED=true

# ── 推理 sidecar（services/inference，见方案 6.3） ──
INFERENCE_BASE_URL=http://127.0.0.1:8100
INFERENCE_TIMEOUT_MS=60000
# 仅 sidecar 自身读取；models/ 不复制，用路径引用旧目录
# EMBEDDING_MODEL_PATH=D:\PROJECT\mcp_tool_sample\models\embedding\bge-m3
# RERANKER_MODEL_PATH=D:\PROJECT\mcp_tool_sample\models\reranker\bge-reranker-v2-m3

# ── MCP Server（apps/mcp） ──
MCP_HOST=127.0.0.1
MCP_PORT=8001

# ── Redis（旧版业务代码未使用，本期不接入） ──
# REDIS_HOST=localhost
# REDIS_PORT=6379
